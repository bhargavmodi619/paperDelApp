{
  // Cloudflare Workers config; `npx wrangler deploy` reads this.
  //
  // The Worker serves dist/ as static assets and handles exactly one route
  // itself: POST /e, the analytics beacon (worker/index.js). Requests that
  // match a file in dist/ never reach the script.
  //
  // The repo was set up for Pages (claude.md 5) but Cloudflare's dashboard
  // now steers new projects to Workers; the two serve the same files. The
  // free tier differs: Pages is unlimited, Workers is 100k requests/day,
  // which is far more than a prototype will see.
  "name": "paperswag",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // serve /paper-round.html and /index.html as-is, no rewriting
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Workers Analytics Engine: append-only event rows, queried with SQL.
  // The dataset is created on first write. tools/stats.js reads it.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "paperswag_events" }
  ],
  "observability": { "enabled": true }
}

# Cloudflare Pages headers.
#
# The game is updated often while it is being tested, and a phone that
# cached Monday's build will report Monday's bugs on Thursday. So: nothing
# is cached without revalidating. The site is small enough that this costs
# nothing noticeable.
#
# X-Robots-Tag backs up the <meta> noindex and robots.txt: the link is meant
# to be passed around by hand, not found.

/*
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The icon never changes between builds; let it live in caches.
/icon.png
  Cache-Control: public, max-age=604800
